{
  "name": "@lemmaria/adapters",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pdfium-wasm": {
      "types": "./dist/pdf/wasm-path.d.ts",
      "default": "./dist/pdf/wasm-path.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@embedpdf/pdfium": "2.15.1",
    "@lemmaria/harness": "workspace:^",
    "@unified-latex/unified-latex-types": "^1.8.4",
    "@unified-latex/unified-latex-util-arguments": "^1.8.4",
    "@unified-latex/unified-latex-util-macros": "^1.8.4",
    "@unified-latex/unified-latex-util-parse": "^1.8.4",
    "@unified-latex/unified-latex-util-print-raw": "^1.8.4",
    "fast-png": "^8.0.0"
  }
}
