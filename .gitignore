# LaTeX build artifacts (fixtures compiled locally)
packages/*/test/fixtures/**/*.aux
packages/*/test/fixtures/**/*.fdb_latexmk
packages/*/test/fixtures/**/*.fls
packages/*/test/fixtures/**/*.log
packages/*/test/fixtures/**/*.pdf
# ...except the PDFs a test reads: they are inputs, not build output. Each is
# named, so a stray build artifact stays ignored.
!packages/adapters/test/fixtures/simple-en/main.pdf
!packages/adapters/test/fixtures/scaled-figure/figure.pdf
!packages/adapters/test/fixtures/scaled-figure/main.pdf
!packages/adapters/test/fixtures/visual-defects/main.pdf
!packages/adapters/test/fixtures/acmart-review/main.pdf
!packages/extension/test/fixtures/review-pdf/main.pdf
packages/*/test/fixtures/**/*.synctex.gz

