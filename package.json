{
  "name": "lemmaria-workspace",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:ext": "pnpm --filter lemmaria run test:ext",
    "test:live": "pnpm --filter @lemmaria/cli run test:live",
    "test:manual": "node scripts/test-manual.mjs",
    "package:ext": "pnpm --filter lemmaria run package && node scripts/check-vsix-contents.mjs",
    "publish:ext": "node scripts/publish.mjs",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r run typecheck",
    "check:boundaries": "depcruise packages --config .dependency-cruiser.cjs && node scripts/check-vscode-imports.mjs && node scripts/check-mixed-language-strings.mjs && node scripts/check-webview-innerhtml.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.0",
    "@types/node": "^20.14.0",
    "dependency-cruiser": "^16.0.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
